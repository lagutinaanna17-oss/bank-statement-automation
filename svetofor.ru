# Одна банковская операция
операция = {
    "контрагент": "ООО Ромашка",
    "сумма": 15000,
    "назначение": "Оплата по счету №123 за услуги",
    "есть_документ": True
}

# Правило светофора: определяем статус операции
if операция["есть_документ"] == True:
    статус = "🟢 зелёный — проводим в 1С"
elif операция["есть_документ"] == False and операция["сумма"] < 10000:
    статус = "🟡 жёлтый — мелкая сумма, запросить документ"
else:
    статус = "🔴 красный — нужен бухгалтер"

print("Контрагент:", операция["контрагент"])
print("Сумма:", операция["сумма"])
print("Статус:", статус)
