# Скопируйте этот файл в /etc/uchis.env на сервере и впишите свои значения. Сам файл с ключами никому не показывайте.

# Адрес сайта, как его видят посетители
BASE_URL=https://ваш-домен.ru

# Где хранить базу данных (аккаунты, подписки, уроки)
DB_PATH=/var/lib/uchis/data.sqlite3

# Ключ Anthropic для ИИ-учителя и заготовки уроков
ANTHROPIC_API_KEY=
# Модель. claude-opus-5-5 — самая сильная из трёх и самая дорогая; claude-sonnet-5-5 вдвое дешевле; claude-haiku-5-5 дешевле в десятки раз, но слабее
CLAUDE_MODEL=claude-opus-5-5

# Магазин в ЮKassa: идентификатор и секретный ключ из личного кабинета
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET=

# Цены за 30 дней, в рублях
PRICE_PRIMARY=49
PRICE_SECONDARY=100

# Сколько вопросов ИИ-учителю можно задать за день с одного аккаунта
TEACHER_DAILY_LIMIT=20
