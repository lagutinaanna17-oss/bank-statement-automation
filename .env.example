# Скопируйте этот файл в .env.local и заполните реальными значениями перед запуском в production

# Яндекс.Метрика — номер счётчика (см. src/app/layout.tsx, компонент YandexMetrika)
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# Яндекс SmartCaptcha — защита форм от ботов
# https://cloud.yandex.ru/docs/smartcaptcha/
NEXT_PUBLIC_SMARTCAPTCHA_SITE_KEY=
SMARTCAPTCHA_SERVER_KEY=

# Telegram-уведомления о новых заявках (см. src/app/api/lead/route.ts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# CRM (amoCRM / Битрикс24) — URL вебхука для передачи лида
CRM_WEBHOOK_URL=

# TODO: ключ LLM-провайдера для ИИ-предиагностики (см. src/app/api/prediagnosis/route.ts)
LLM_API_KEY=
